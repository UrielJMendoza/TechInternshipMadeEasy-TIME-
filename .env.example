# Browser-readable Supabase configuration. Both values are required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional local/manual ingestion configuration. The hosted app does not need
# these values. Never prefix them with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Used only by the fail-closed Next.js manual ingestion route and operator checks.
CRON_SECRET=

# Optional local/manual runner label; Edge always uses the artifact checksum.
INGEST_CODE_VERSION=

# The canonical pg_cron scheduler reads separate Vault entries named
# `ingest_function_url` and `ingest_cron_secret`; their values are provisioned
# during the reviewed deployment and are intentionally absent from this file.
