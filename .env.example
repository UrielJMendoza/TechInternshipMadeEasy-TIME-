# Supabase project (public — safe to expose to the browser).
# Optional: src/lib/supabase.ts falls back to the project's public values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret gating the ingest write path. Must match the value stored in
# the app_meta table ('cron_secret' key) in Supabase.
CRON_SECRET=
