# Supabase project (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret gating the ingest/digest write paths. Must match the value
# stored in the app_meta table ('cron_secret' key) in Supabase.
CRON_SECRET=

# Resend (email digest). Leave unset to disable the digest.
RESEND_API_KEY=
DIGEST_TO=
DIGEST_FROM=onboarding@resend.dev
