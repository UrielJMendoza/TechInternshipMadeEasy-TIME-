# Browser continuity is opt-in. Leave blank to keep tracker data browser-only.
# The only supported configured value is: supabase
NEXT_PUBLIC_TIMLEY_CONTINUITY_PROVIDER=
# The browser exposes account deletion only when this is exactly: 1
NEXT_PUBLIC_TIMLEY_ACCOUNT_DELETION_AVAILABLE=

# Explicit Supabase public browser configuration for optional account sync.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the publishable key. The legacy anon key is an alternative; set only
# one public key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential used exclusively by the account-deletion
# route. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Account deletion is disabled unless this server-only flag is exactly: true
TIMLEY_ACCOUNT_DELETION_ENABLED=

# Before enabling account continuity in production, configure Supabase Auth:
# - Authentication > URL Configuration: Site URL and allowed redirect URLs.
# - Authentication > SMTP: a production sender for confirmation and recovery.
# These values belong in the Supabase dashboard, not in this file.

# Reserved email-alert delivery scaffold. No sender or scheduler is configured
# by these flags; leave them blank until that server-side feature is provided.
NEXT_PUBLIC_TIMLEY_EMAIL_ALERTS_AVAILABLE=
TIMLEY_EMAIL_ALERTS_ENABLED=

# Shared secret gating the ingest write path. Must match the value stored in
# the app_meta table ('cron_secret' key) in Supabase.
CRON_SECRET=
