{
  "name": "internship-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test src/lib/*.test.ts src/components/*.test.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:artifact:generate": "node --import tsx scripts/generate-edge-manifest.ts",
    "ingest:artifact:check": "node --import tsx scripts/check-edge-manifest.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@supabase/supabase-js": "^2.110.1",
    "next": "^16.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
