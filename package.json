{
  "name": "internship-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:coverage": "NODE_V8_COVERAGE=coverage node --import tsx --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=75 --test 'src/**/*.test.ts'",
    "test:db": "supabase db reset --local && supabase test db --local supabase/tests",
    "test:e2e": "playwright test",
    "types:generate": "node --import tsx scripts/generate-database-types.ts",
    "types:check": "node --import tsx scripts/generate-database-types.ts --check",
    "ingest": "node --import tsx scripts/ingest.ts",
    "ingest:artifact:generate": "node --import tsx scripts/generate-edge-manifest.ts",
    "ingest:artifact:check": "node --import tsx scripts/check-edge-manifest.ts",
    "ingest:deployed:verify": "node --import tsx scripts/verify-edge-function.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.2.8",
    "@supabase/supabase-js": "2.110.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
